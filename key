local function Tween(instance, info, props)
    return TweenService:Create(instance, info, props)
end

local function GetGui()
    local gui = Instance.new("ScreenGui")
    gui.Name             = "FacilityKeyGate"
    gui.ResetOnSpawn     = false
    gui.ZIndexBehavior   = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder     = 2147483647
    gui.ScreenInsets     = Enum.ScreenInsets.None

    local parent = RunService:IsStudio()
        and LocalPlayer:FindFirstChild("PlayerGui")
        or  (gethui and gethui())
        or  (cloneref and cloneref(game:GetService("CoreGui")) or game:GetService("CoreGui"))

    gui.Parent = parent
    return gui
end

local function OpenUrl(url)
    if setclipboard then
        setclipboard(url)
    end
    -- Tente d'ouvrir via le navigateur si disponible
    if syn and syn.request then return end
    pcall(function()
        game:GetService("GuiService"):OpenBrowserWindow(url)
    end)
end

