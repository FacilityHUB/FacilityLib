            and Color3.fromRGB(255, 100, 100)
            or  Color3.fromRGB(100, 220, 130)
    end

    local function ValidateKey()
        if validating then return end
        local key = keyBox.Text

        if key == "" or string.gsub(key, "%s", "") == "" then
            SetStatus("⚠  La clé ne peut pas être vide.", true)
            return
        end

        validating = true
        validateBtn.Text = "Validation…"
        Tween(validateBtn, TweenInfo.new(0.15, Enum.EasingStyle.Sine), {
            BackgroundColor3 = Color3.fromRGB(25, 25, 25),
            TextTransparency = 0.4
        }):Play()
        SetStatus("", false)

        -- Validation locale (à remplacer par un appel HTTP si nécessaire)
        task.spawn(function()
            local success = false
            local errorMsg = "Clé invalide ou expirée."

            -- ── Option A : validation via HTTP ──────────────────────────
            -- Décommente et adapte si tu as un endpoint REST :
            --[[
            local ok, res = pcall(function()
                return request({
                    Url    = CONFIG.ValidateEndpoint,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body   = HttpService:JSONEncode({ key = key }),
                })
            end)
            if ok and res and res.StatusCode == 200 then
                local data = pcall(HttpService.JSONDecode, HttpService, res.Body)
                success  = data and data.valid == true
                errorMsg = (data and data.message) or errorMsg
            end
            ]]

            -- ── Option B : validation locale (liste blanche) ─────────────
            local whitelist = {
                -- Ajoute tes clés ici pendant les tests :
                -- "FACILITY-XXXX-XXXX-XXXX",
            }
            for _, validKey in ipairs(whitelist) do
                if validKey == key then
                    success = true
                    break
                end
            end

            task.wait(1.2) -- Simulation délai réseau

            if success then
                SetStatus("✓  Clé validée. Chargement…", false)
                validateBtn.Text = "✓ Accès accordé"
                Tween(validateBtn, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {
                    BackgroundColor3 = Color3.fromRGB(40, 80, 50),
                    TextTransparency = 0.1
                }):Play()
                Tween(validateStroke, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {
                    Transparency = 0.5
                }):Play()

                task.wait(0.8)

                -- Animation de fermeture
                local canvasOut = Instance.new("CanvasGroup")
                canvasOut.Size              = UDim2.fromScale(1, 1)
                canvasOut.BackgroundTransparency = 1
                canvasOut.GroupTransparency = 0
                canvasOut.Parent            = screenGui

                window.Parent  = canvasOut
                overlay.Parent = canvasOut

                Tween(canvasOut, TweenInfo.new(0.25, Enum.EasingStyle.Sine), {
                    GroupTransparency = 1
                }):Play()

                task.wait(0.3)
                screenGui:Destroy()

                if onSuccess then
                    task.spawn(onSuccess)
                end
            else
                SetStatus("✗  " .. errorMsg, true)
                validateBtn.Text = "Validate Key"
                Tween(validateBtn, TweenInfo.new(0.15, Enum.EasingStyle.Sine), {
                    BackgroundColor3 = Color3.fromRGB(30, 30, 30),
                    TextTransparency = 0.1
                }):Play()

                -- Shake de l'input
                local origPos = inputHolder.Position
                for i = 1, 3 do
                    Tween(inputHolder, TweenInfo.new(0.05, Enum.EasingStyle.Sine), {
                        Position = origPos + UDim2.fromOffset(5, 0)
                    }):Play()
                    task.wait(0.05)
                    Tween(inputHolder, TweenInfo.new(0.05, Enum.EasingStyle.Sine), {
                        Position = origPos + UDim2.fromOffset(-5, 0)
                    }):Play()
                    task.wait(0.05)
                end
                inputHolder.Position = origPos

                validating = false
            end
        end)
    end

    validateBtn.MouseButton1Click:Connect(ValidateKey)
    keyBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then ValidateKey() end
    end)

    -- ================================================
    --  ANIMATION D'ENTRÉE
    -- ================================================
    local uiScale = Instance.new("UIScale")
    uiScale.Scale  = 0.93
    uiScale.Parent = window

    window.BackgroundTransparency = 1
    overlay.BackgroundTransparency = 1

    Tween(overlay, TweenInfo.new(0.2, Enum.EasingStyle.Sine), { BackgroundTransparency = 0.45 }):Play()
    Tween(window,  TweenInfo.new(0.2, Enum.EasingStyle.Sine), { BackgroundTransparency = 0.03 }):Play()
    Tween(uiScale, TweenInfo.new(0.25, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), { Scale = 1 }):Play()

    return screenGui
end

return KeyGate
