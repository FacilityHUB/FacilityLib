					hue = (hue + dt * 0.1) % 1
					alphaColorPicker:SetColor(Color3.fromHSV(hue, 1, 1))
				end)
			elseif rainbowConnection then
				rainbowConnection:Disconnect()
				rainbowConnection = nil
			end
		end,
	}, "DemoRainbow")

	-- INPUTS / KEYBINDS
	sections.MainSection2:Header({ Text = "Input & Keybind" })
	sections.MainSection2:Input({
		Name = "Username",
		Default = "",
		Placeholder = "Enter your name",
		AcceptedCharacters = "All",
		CharacterLimit = 20,
		Callback = function(text) print("Input:", text) end,
	}, "DemoInput")

	sections.MainSection2:Keybind({
		Name = "Action Bind",
		Default = Enum.KeyCode.E,
		Callback = function(key) print("Pressed:", key) end,
	}, "DemoKeybind")

	-- DROPDOWNS
	sections.MainSection2:Header({ Text = "Dropdowns" })
	sections.MainSection2:Dropdown({
		Name = "Single Choice",
		Multi = false,
		Required = true,
		Options = { "Apple", "Banana", "Cherry" },
		Default = 1,
		Callback = function(opt) print("Selected:", opt) end,
	}, "DemoDropdown1")

	sections.MainSection2:Dropdown({
		Name = "Multi Choice",
		Multi = true,
		Required = false,
		Options = { "Apple", "Banana", "Cherry", "Orange", "Grape" },
		Default = { "Apple" },
		Callback = function(opts)
			local sel = {}
			for k, v in pairs(opts) do if v then table.insert(sel, k) end end
			print("Selected:", table.concat(sel, ", "))
		end,
	}, "DemoDropdown2")

	-- HEADER / LABEL / PARAGRAPH
	sections.MainSection2:Header({ Text = "Texts" })
	sections.MainSection2:Label({ Text = "This is a label" })
	sections.MainSection2:SubLabel({ Text = "This is a sublabel with smaller text." })
	sections.MainSection2:Paragraph({
		Header = "Paragraph Header",
		Body = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore.",
	})
	sections.MainSection2:Divider()

	-- ============== ONGLET THEMES ==============
	local ThemesTab = TabGroup:Tab({
		Name = "Themes",
		Image = "rbxassetid://10734950309",
	})

	local themeSection = ThemesTab:Section({ Side = "Left" })
	themeSection:Header({ Text = "Theme Selection" })
	themeSection:Paragraph({
		Header = "Choose Your Theme",
		Body = "Click on a theme below to apply it instantly.",
	})

	themeSection:Dropdown({
		Name = "Active Theme",
		Multi = false,
		Required = true,
		Options = MacLib:GetAvailableThemes(),
		Default = MacLib:GetCurrentTheme(),
		Callback = function(theme)
			if theme and MacLib.Themes.List[theme] then
				MacLib:SetTheme(theme, true)
				Window:Notify({
					Title = "Theme",
					Description = "Applied: " .. theme,
					Lifetime = 2,
				})
			end
		end,
	}, "DemoThemeSel")

	-- Boutons rapides pour chaque theme
	local quickSection = ThemesTab:Section({ Side = "Right" })
	quickSection:Header({ Text = "Quick Switch" })
	for _, themeName in ipairs(MacLib:GetAvailableThemes()) do
		quickSection:Button({
			Name = themeName,
			Callback = function()
				MacLib:SetTheme(themeName, true)
				Window:Notify({
					Title = "Theme",
					Description = "Applied: " .. themeName,
					Lifetime = 2,
				})
			end,
		})
	end

	-- ============== ONGLET SETTINGS ==============
	Window:BuildSettingsTab()

	-- Sélectionne le premier onglet
	DemoTab:Select()

	return Window
end

return MacLib
