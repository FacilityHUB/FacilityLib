						if IS.CharacterLimit then return value:sub(1, IS.CharacterLimit) end
						return value
					end

					local CharSubs = {
						All = function(v) return applyCharLimit(v) end,
						Numeric = function(v)
							local r = v:match("^%-?%d*$") and v or v:gsub("[^%d-]", "")
							return applyCharLimit(r)
						end,
						Alphabetic = function(v) return applyCharLimit(v:gsub("[^a-zA-Z ]", "")) end,
						AlphaNumeric = function(v) return applyCharLimit(v:gsub("[^a-zA-Z0-9]", "")) end,
					}

					local AC = type(IS.AcceptedCharacters) == "function" and IS.AcceptedCharacters or (CharSubs[IS.AcceptedCharacters] or CharSubs.All)

					inputBox.AutomaticSize = Enum.AutomaticSize.X

					local function checkSize()
						local maxWidth = (input.AbsoluteSize.X - inputName.AbsoluteSize.X - 20) / baseUIScale.Scale
						inputBoxUISizeConstraint.MaxSize = Vector2.new(maxWidth, 9e9)
					end
					checkSize()
					inputName:GetPropertyChangedSignal("AbsoluteSize"):Connect(checkSize)

					inputBox.FocusLost:Connect(function()
						local f = AC(inputBox.Text)
						inputBox.Text = f
						task.spawn(function()
							if IS.Callback then IS.Callback(f) end
						end)
					end)
					inputBox.Text = IS.Default or ""
					inputBox.PlaceholderText = IS.Placeholder or ""

					inputBox:GetPropertyChangedSignal("Text"):Connect(function()
						inputBox.Text = AC(inputBox.Text)
						if IS.onChanged then IS.onChanged(inputBox.Text) end
						IF.Text = inputBox.Text
					end)

					function IF:UpdateName(Name) inputName.Text = Name end
					function IF:SetVisibility(State) input.Visible = State end
					function IF:GetInput() return inputBox.Text end
					function IF:UpdatePlaceholder(P) inputBox.PlaceholderText = P end
					function IF:UpdateText(Text)
						local f = AC(Text)
						inputBox.Text = f
						IF.Text = f
						task.spawn(function()
							if IS.Callback then IS.Callback(f) end
						end)
					end

					if Flag then MacLib.Options[Flag] = IF end
					return IF
				end

