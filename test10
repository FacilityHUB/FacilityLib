					local function makeRGBInput(t, o)
						local wrap = Instance.new("Frame")
						wrap.Size = UDim2.new(1/3, -4, 1, 0)
						wrap.BackgroundTransparency = 1
						wrap.LayoutOrder = o
						wrap.Parent = rgbRow

						local lbl = Instance.new("TextLabel")
						lbl.Size = UDim2.fromOffset(14, 26)
						lbl.BackgroundTransparency = 1
						lbl.Text = t
						lbl.FontFace = Font.new(assets.interFont, Enum.FontWeight.Medium, Enum.FontStyle.Normal)
						lbl.TextSize = 12
						lbl.TextXAlignment = Enum.TextXAlignment.Left
						lbl.Parent = wrap
						MacLib:Theme(lbl, { TextColor3 = "SubText" })

						local bg = Instance.new("Frame")
						bg.Size = UDim2.new(1, -18, 0, 26)
						bg.Position = UDim2.fromOffset(18, 0)
						bg.BackgroundTransparency = 0.95
						bg.BorderSizePixel = 0
						bg.Parent = wrap

						local bgC = Instance.new("UICorner")
						bgC.CornerRadius = UDim.new(0, 5)
						bgC.Parent = bg

						local bgS = Instance.new("UIStroke")
						bgS.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
						bgS.Parent = bg
						MacLib:Theme(bgS, {
							Color = "Stroke",
							Transparency = "StrokeTransparency"
						})

						local inp = Instance.new("TextBox")
						inp.Size = UDim2.new(1, -10, 1, 0)
						inp.Position = UDim2.fromOffset(5, 0)
						inp.BackgroundTransparency = 1
						inp.Text = "0"
						inp.FontFace = Font.new(assets.interFont)
						inp.TextSize = 12
						inp.ClearTextOnFocus = false
						inp.Parent = bg
						MacLib:Theme(inp, { TextColor3 = "Text" })

						return inp
					end

					local rInput = makeRGBInput("R", 1)
					local gInput = makeRGBInput("G", 2)
					local bInput = makeRGBInput("B", 3)

					-- Logique
					local h, s, v = Color3.toHSV(CF.Color)
					local alpha = CF.Alpha or 0
					local svDrag, hueDrag, aDrag = false, false, false
					local updating = false

					local function updateUI()
						if updating then return end
						updating = true
						local nc = Color3.fromHSV(h, s, v)
						swatch.BackgroundColor3 = nc
						previewBox.BackgroundColor3 = nc

						local pure = Color3.fromHSV(h, 1, 1)
						svWhiteGrad.Color = ColorSequence.new({
							ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
							ColorSequenceKeypoint.new(1, pure),
						})

						svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
						hueCursor.Position = UDim2.new(0, -3, h, -2)

						if aBar then aBar.BackgroundColor3 = nc end

						hexInput.Text = rgbToHex(nc)
						rInput.Text = tostring(math.floor(nc.R * 255 + 0.5))
						gInput.Text = tostring(math.floor(nc.G * 255 + 0.5))
						bInput.Text = tostring(math.floor(nc.B * 255 + 0.5))
						updating = false
					end

					updateUI()

					hexInput.FocusLost:Connect(function()
						local c = hexToRgb(hexInput.Text)
						if c then h, s, v = Color3.toHSV(c); updateUI()
						else hexInput.Text = rgbToHex(Color3.fromHSV(h, s, v)) end
					end)

					local function fromRGB()
						local r = tonumber(rInput.Text)
						local g = tonumber(gInput.Text)
						local b = tonumber(bInput.Text)
						if not (r and g and b) then return end
						r, g, b = math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255)
						h, s, v = Color3.toHSV(Color3.fromRGB(r, g, b))
						updateUI()
					end
					rInput.FocusLost:Connect(fromRGB)
					gInput.FocusLost:Connect(fromRGB)
					bInput.FocusLost:Connect(fromRGB)

					svBox.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							svDrag = true
							local ap, asz = svBox.AbsolutePosition, svBox.AbsoluteSize
							s = math.clamp((input.Position.X - ap.X) / asz.X, 0, 1)
							v = 1 - math.clamp((input.Position.Y - ap.Y) / asz.Y, 0, 1)
							updateUI()
						end
					end)

					hueBar.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							hueDrag = true
							local ap, asz = hueBar.AbsolutePosition, hueBar.AbsoluteSize
							h = math.clamp((input.Position.Y - ap.Y) / asz.Y, 0, 1)
							updateUI()
						end
					end)

					if aBar then
						aBar.InputBegan:Connect(function(input)
							if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
								aDrag = true
								local ap, asz = aBar.AbsolutePosition, aBar.AbsoluteSize
								alpha = math.clamp((input.Position.X - ap.X) / asz.X, 0, 1)
								aCursor.Position = UDim2.new(alpha, -2, 0, -3)
							end
						end)
					end

					UserInputService.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							svDrag, hueDrag, aDrag = false, false, false
						end
					end)

					UserInputService.InputChanged:Connect(function(input)
						if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
						if svDrag then
							local ap, asz = svBox.AbsolutePosition, svBox.AbsoluteSize
							s = math.clamp((input.Position.X - ap.X) / asz.X, 0, 1)
							v = 1 - math.clamp((input.Position.Y - ap.Y) / asz.Y, 0, 1)
							updateUI()
						elseif hueDrag then
							local ap, asz = hueBar.AbsolutePosition, hueBar.AbsoluteSize
							h = math.clamp((input.Position.Y - ap.Y) / asz.Y, 0, 1)
							updateUI()
						elseif aDrag and aBar then
							local ap, asz = aBar.AbsolutePosition, aBar.AbsoluteSize
							alpha = math.clamp((input.Position.X - ap.X) / asz.X, 0, 1)
							aCursor.Position = UDim2.new(alpha, -2, 0, -3)
						end
					end)

					-- Transition
					local activeCanvas = nil
					local function transition(isIn)
						if isIn then
							activeCanvas = Instance.new("CanvasGroup")
							activeCanvas.BackgroundTransparency = 1
							activeCanvas.BorderSizePixel = 0
							activeCanvas.Size = UDim2.fromScale(1, 1)
							activeCanvas.ZIndex = 100
							activeCanvas.GroupTransparency = 1
							activeCanvas.Parent = base
							colorPicker.Parent = activeCanvas
							colorPicker.Visible = true
							Tween(activeCanvas, TweenInfo.new(0.15), { GroupTransparency = 0 }):Play()
							Tween(promptScale, TweenInfo.new(0.15), { Scale = 1 }):Play()
						else
							if not activeCanvas then return end
							local ft = Tween(activeCanvas, TweenInfo.new(0.15), { GroupTransparency = 1 })
							Tween(promptScale, TweenInfo.new(0.15), { Scale = 0.95 }):Play()
							ft:Play()
							ft.Completed:Wait()
							colorPicker.Visible = false
							colorPicker.Parent = nil
							activeCanvas:Destroy()
							activeCanvas = nil
						end
					end

					local isOpen = false
					local outsideConn = nil

					local function applyColor()
						local fc = Color3.fromHSV(h, s, v)
						CF.Color = fc
						CF.Alpha = isAlpha and alpha or 0
						swatch.BackgroundColor3 = fc
						if CS.Callback then
							task.spawn(function()
								CS.Callback(fc, isAlpha and alpha or nil)
							end)
						end
					end

					local function pickerOut()
						if not isOpen then return end
						isOpen = false
						if outsideConn then outsideConn:Disconnect(); outsideConn = nil end
						applyColor()
						transition(false)
					end

					local function pickerIn()
						if isOpen then return end
						isOpen = true
						transition(true)
						task.wait(0.2)
						outsideConn = UserInputService.InputBegan:Connect(function(input)
							if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
							if not isOpen then return end
							local mp, pp, ps = input.Position, prompt.AbsolutePosition, prompt.AbsoluteSize
							local inside = mp.X >= pp.X and mp.X <= pp.X + ps.X and mp.Y >= pp.Y and mp.Y <= pp.Y + ps.Y
							if not inside then pickerOut() end
						end)
					end

					swatch.MouseButton1Click:Connect(function()
						if isOpen then pickerOut() else pickerIn() end
					end)

					function CF:UpdateName(N) colorpickerName.Text = N end
					function CF:SetVisibility(S) colorpicker.Visible = S end
					function CF:SetColor(c)
						CF.Color = c
						swatch.BackgroundColor3 = c
						h, s, v = Color3.toHSV(c)
						updateUI()
						if CS.Callback then
							task.spawn(function()
								CS.Callback(c, isAlpha and alpha or nil)
							end)
						end
					end
					function CF:SetAlpha(a)
						alpha = a
						CF.Alpha = a
						if aCursor then aCursor.Position = UDim2.new(alpha, -2, 0, -3) end
					end

					if Flag then MacLib.Options[Flag] = CF end
					return CF
				end

