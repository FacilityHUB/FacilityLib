						checkmark.TextTransparency = 1
						checkmark.TextXAlignment = Enum.TextXAlignment.Left
						checkmark.AnchorPoint = Vector2.new(0, 0.5)
						checkmark.BackgroundTransparency = 1
						checkmark.BorderSizePixel = 0
						checkmark.LayoutOrder = -1
						checkmark.Position = UDim2.fromScale(0, 0.5)
						checkmark.Size = UDim2.fromOffset(-10, 0)
						checkmark.Parent = option
						MacLib:Theme(checkmark, { TextColor3 = "Accent" })

						option.Parent = ddFrame
						ddFrame.Parent = dropdown

						OptionObjs[v] = { Index = i, Button = option, NameLabel = optName, Checkmark = checkmark }

						local sel = false
						if DS.Default then
							if DS.Multi then
								sel = table.find(DS.Default, v) and true or false
							else
								sel = (DS.Default == i) and true or false
							end
						end
						Toggle(v, sel)

						option.MouseButton1Click:Connect(function()
							local isSel = table.find(Selected, v) and true or false
							local newSel = not isSel
							if DS.Required and not newSel and #Selected <= 1 then return end
							Toggle(v, newSel)
							task.spawn(function()
								if DS.Multi then
									local Ret = {}
									for _, o in ipairs(Selected) do Ret[o] = true end
									if DS.Callback then DS.Callback(Ret) end
								else
									if newSel and DS.Callback then DS.Callback(Selected[1]) end
								end
							end)
						end)
					end

					if DS.Options then
						for i, v in pairs(DS.Options) do addOption(i, v) end
					end

					function DF:UpdateName(N) dropdownName.Text = N end
					function DF:SetVisibility(S) dropdown.Visible = S end
					function DF:UpdateSelection(ns)
						if not ns then return end
						for o, _ in pairs(OptionObjs) do Toggle(o, false) end
						local selOpts = {}
						if type(ns) == "number" then
							for o, d in pairs(OptionObjs) do
								if d.Index == ns then Toggle(o, true); table.insert(selOpts, o) end
							end
						elseif type(ns) == "string" then
							for o, _ in pairs(OptionObjs) do
								if o == ns then Toggle(o, true); table.insert(selOpts, o) end
							end
						elseif type(ns) == "table" then
							for o, _ in pairs(OptionObjs) do
								if table.find(ns, o) then Toggle(o, true); table.insert(selOpts, o) end
							end
						end
						if DS.Callback then
							if DS.Multi then
								local R = {}
								for _, o in ipairs(selOpts) do R[o] = true end
								DS.Callback(R)
							else
								DS.Callback(selOpts[1])
							end
						end
					end
					function DF:InsertOptions(no)
						if not no then return end
						DS.Options = no
						for i, v in pairs(no) do addOption(i, v) end
					end
					function DF:ClearOptions()
						for _, od in pairs(OptionObjs) do od.Button:Destroy() end
						OptionObjs = {}; Selected = {}
					end
					function DF:GetOptions()
						local s = {}
						for o in pairs(OptionObjs) do
							s[o] = table.find(Selected, o) and true or false
						end
						return s
					end

					if Flag then MacLib.Options[Flag] = DF end
					return DF
				end

