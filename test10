			local function SelectCurrentTab()
				local et = 0.15
				if currentTabInstance then currentTabInstance.Parent = nil end

				for i, ti in pairs(tabs) do
					Tween(i, TweenInfo.new(et, Enum.EasingStyle.Sine), {
						BackgroundTransparency = (i == tabSwitcher and 0.98 or 1)
					}):Play()
					if ti.tabStroke then
						Tween(ti.tabStroke, TweenInfo.new(et, Enum.EasingStyle.Sine), {
							Transparency = (i == tabSwitcher and 0.95 or 1)
						}):Play()
					end
					if ti.switcherImage then
						Tween(ti.switcherImage, TweenInfo.new(et, Enum.EasingStyle.Sine), {
							ImageTransparency = (i == tabSwitcher and 0.1 or 0.5)
						}):Play()
					end
					if ti.switcherName then
						Tween(ti.switcherName, TweenInfo.new(et, Enum.EasingStyle.Sine), {
							TextTransparency = (i == tabSwitcher and 0.1 or 0.5)
						}):Play()
					end
				end

				tabs[tabSwitcher].tabContent.Parent = content
				currentTabInstance = tabs[tabSwitcher].tabContent
				currentTab.Text = SettingsArg.Name
			end

