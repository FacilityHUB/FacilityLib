						local h, c = 0, 0
						for _, v in pairs(ddFrame:GetChildren()) do
							if not v:IsA("UIComponent") and v.Visible then
								h += v.AbsoluteSize.Y
								c += 1
							end
						end
						return h + ddFrameList.Padding.Offset * (c-1) + 48
					end

					local tw = { dur = 0.2, ease = Enum.EasingStyle.Quint }

					local function Toggle(name, state)
						local opt = OptionObjs[name]
						if not opt then return end

						if state then
							if DS.Multi then
								if not table.find(Selected, name) then table.insert(Selected, name) end
							else
								for n, o in pairs(OptionObjs) do
									if n ~= name then
										o.Checkmark.Size = UDim2.new(0, -10, 0, 0)
										o.NameLabel.TextTransparency = 0.5
										o.Checkmark.TextTransparency = 1
									end
								end
								Selected = { name }
							end
							opt.Checkmark.Size = UDim2.new(0, 12, 0, 0)
							opt.NameLabel.TextTransparency = 0.2
							opt.Checkmark.TextTransparency = 0
						else
							if DS.Multi then
								local i = table.find(Selected, name)
								if i then table.remove(Selected, i) end
							else
								Selected = {}
							end
							opt.Checkmark.Size = UDim2.new(0, -10, 0, 0)
							opt.NameLabel.TextTransparency = 0.5
							opt.Checkmark.TextTransparency = 1
						end

						if DS.Required and #Selected == 0 and not state then return end

						DF.Value = DS.Multi and Selected or Selected[1]

						if #Selected > 0 then
							dropdownName.Text = DS.Name .. " • " .. table.concat(Selected, ", ")
						else
							dropdownName.Text = DS.Name .. "..."
						end
					end

					local dropped, db = false, false

					local function ToggleDD()
						if db then return end
						db = true
						local target = (not dropped) and UDim2.new(1, 0, 0, CalcSize()) or UDim2.new(1, 0, 0, 38)

						local dt = Tween(dropdown, TweenInfo.new(0.2, Enum.EasingStyle.Exponential), { Size = target })
						Tween(ddImage, TweenInfo.new(0.2), { Rotation = (not dropped) and -90 or 0 }):Play()
						dt:Play()

						if not dropped then
							ddFrame.Visible = true
							dt.Completed:Connect(function() db = false end)
						else
							dt.Completed:Connect(function()
								ddFrame.Visible = false
								db = false
							end)
						end
						dropped = not dropped
					end

					interactDD.MouseButton1Click:Connect(ToggleDD)

					local function addOption(i, v)
						local option = Instance.new("TextButton")
