	-- ClassParser & Configs
	local ClassParser = {
		["Toggle"] = {
			Save = function(F, d) return { type = "Toggle", flag = F, state = d.State or false } end,
			Load = function(F, d) if MacLib.Options[F] and d.state then MacLib.Options[F]:UpdateState(d.state) end end
		},
		["Slider"] = {
			Save = function(F, d) return { type = "Slider", flag = F, value = d.Value and tostring(d.Value) or false } end,
			Load = function(F, d) if MacLib.Options[F] and d.value then MacLib.Options[F]:UpdateValue(d.value) end end
		},
		["Input"] = {
			Save = function(F, d) return { type = "Input", flag = F, text = d.Text } end,
			Load = function(F, d) if MacLib.Options[F] and d.text then MacLib.Options[F]:UpdateText(d.text) end end
		},
		["Keybind"] = {
			Save = function(F, d)
				return { type = "Keybind", flag = F, key = d.Settings.Default and d.Settings.Default.Name or nil }
			end,
			Load = function(F, d)
				if MacLib.Options[F] and d.key then
					local key = Enum.KeyCode[d.key]
					if key then MacLib.Options[F]:Bind(key) end
				end
			end
		},
		["Dropdown"] = {
			Save = function(F, d)
				local sel = {}
				if d.Settings.Multi then
					for o, isSel in pairs(d:GetOptions()) do
						if isSel then table.insert(sel, o) end
					end
				else
					sel = d.Value
				end
				return { type = "Dropdown", flag = F, value = sel }
			end,
			Load = function(F, d)
				if MacLib.Options[F] and d.value then
					MacLib.Options[F]:UpdateSelection(d.value)
				end
			end
		},
		["Colorpicker"] = {
			Save = function(F, d)
				return {
					type = "Colorpicker",
					flag = F,
					color = { d.Color.R, d.Color.G, d.Color.B },
					alpha = d.Alpha
				}
			end,
			Load = function(F, d)
				if MacLib.Options[F] and d.color then
					MacLib.Options[F]:SetColor(Color3.new(d.color[1], d.color[2], d.color[3]))
					if d.alpha and MacLib.Options[F].SetAlpha then
						MacLib.Options[F]:SetAlpha(d.alpha)
					end
				end
			end
		},
	}

	-- Helpers de fichiers (executor required)
	local function fileExists(p) return isfile and isfile(p) end
	local function fileRead(p) return readfile and readfile(p) or "" end
	local function fileWrite(p, c) if writefile then writefile(p, c) end end
	local function makeFolder(p) if makefolder and not (isfolder and isfolder(p)) then makefolder(p) end end
	local function listFolder(p) return listfiles and listfiles(p) or {} end

	function MacLib:BuildFolderTree()
		if isStudio then return end
		makeFolder(MacLib.Folder)
		makeFolder(MacLib.Folder .. "/Configs")
	end

	function MacLib:RefreshConfigList()
		if isStudio then return {} end
		MacLib:BuildFolderTree()
		local list = {}
		for _, f in ipairs(listFolder(MacLib.Folder .. "/Configs")) do
			local n = f:match("([^/\\]+)%.json$")
			if n then table.insert(list, n) end
		end
		return list
	end

	function MacLib:SaveConfig(name)
		if isStudio or not name then return end
		MacLib:BuildFolderTree()
		local data = {}
		for flag, opt in pairs(MacLib.Options) do
			if opt.IgnoreConfig then continue end
			local cls = opt.Class
			local p = ClassParser[cls]
			if p and p.Save then
				table.insert(data, p.Save(flag, opt))
			end
		end
		local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
		if ok then
			fileWrite(MacLib.Folder .. "/Configs/" .. name .. ".json", encoded)
		end
	end

	function MacLib:LoadConfig(name)
		if isStudio or not name then return end
		local path = MacLib.Folder .. "/Configs/" .. name .. ".json"
		if not fileExists(path) then return end
		local ok, data = pcall(HttpService.JSONDecode, HttpService, fileRead(path))
		if not ok or not data then return end

		for _, item in ipairs(data) do
			local cls = item.type
			local p = ClassParser[cls]
			if p and p.Load and item.flag then
				p.Load(item.flag, item)
			end
		end
	end

	function MacLib:SetFolder(folderName)
		MacLib.Folder = folderName
		MacLib:BuildFolderTree()
	end

	function MacLib:LoadAutoLoadConfig()
		if isStudio then return end
		local autoPath = MacLib.Folder .. "/autoload.txt"
		if fileExists(autoPath) then
			local cfg = fileRead(autoPath)
			MacLib:LoadConfig(cfg)
		end
	end

