						end
						if dropped then dropdown.Size = UDim2.new(1, 0, 0, CalculateDropdownSize()) end
					end
					function DropdownFunctions:IsOption(optionName)
						if not optionName then return end
						return OptionObjs[optionName] ~= nil
					end

