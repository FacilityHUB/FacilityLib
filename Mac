					-- ============== LOGIQUE COULEUR ==============
					local fromHSV = Color3.fromHSV
					local v2 = Vector2.new
					local udim2 = UDim2.new
					local Mouse = LocalPlayer:GetMouse()

					local WheelDown, SlideDown = false, false
					local hue, saturation, value = 0, 0, 1

					local function toPolar(v)
						return math.atan2(v.y, v.x), v.magnitude
					end

					local function radToDeg(x)
						return ((x + math.pi) / (2 * math.pi)) * 360
					end

					local function degToRad(degrees)
						return degrees * (math.pi / 180)
					end

					local function hexToRGB(hex)
						hex = hex:gsub("#","")
						if #hex ~= 6 then return 0, 0, 0 end
						local r = tonumber(hex:sub(1, 2), 16) or 0
						local g = tonumber(hex:sub(3, 4), 16) or 0
						local b = tonumber(hex:sub(5, 6), 16) or 0
						return r, g, b
					end

					local function clampInput(value, min, max)
						local num = tonumber(value)
						if num then return math.clamp(num, min, max) end
						return min
					end

					-- Met à jour les inputs depuis HSV
					local function updateInputs()
						local c = fromHSV(hue, saturation, value)

						redInput.Text = tostring(math.floor(c.r * 255 + 0.5))
						greenInput.Text = tostring(math.floor(c.g * 255 + 0.5))
						blueInput.Text = tostring(math.floor(c.b * 255 + 0.5))

						local hexColor = string.format("#%02X%02X%02X",
							math.floor(c.r * 255 + 0.5),
							math.floor(c.g * 255 + 0.5),
							math.floor(c.b * 255 + 0.5))
						hexInput.Text = hexColor
					end

					local function UpdateSlide(iX)
						local rY = iX - valueBar.AbsolutePosition.X
						local cY = math.clamp(rY, 0, valueBar.AbsoluteSize.X - valueSlide.AbsoluteSize.X)
						valueSlide.Position = udim2(0, cY, 0.5, 0)
						value = 1 - (cY / (valueBar.AbsoluteSize.X - valueSlide.AbsoluteSize.X))
						updateInputs()
					end

					local function UpdateRing(iX, iY)
						local r = wheelButton.AbsoluteSize.x / 2
						local d = v2(iX, iY) - wheelButton.AbsolutePosition - wheelButton.AbsoluteSize / 2

						if d:Dot(d) > r * r then
							d = d.unit * r
						end

						wheelTarget.Position = udim2(0.5, d.x, 0.5, d.y)
						local phi, len = toPolar(d * v2(1, -1))
						hue, saturation = radToDeg(phi) / 360, math.clamp(len / r, 0, 1)
						valueBar.BackgroundColor3 = fromHSV(hue, saturation, 1)
						updateInputs()
					end

					local function UpdateSlideFromValue(val)
						local cY = (1 - val) * (valueBar.AbsoluteSize.X - valueSlide.AbsoluteSize.X)
						valueSlide.Position = UDim2.new(0, cY, 0.5, 0)
					end

					local function UpdateRingFromHSV(h, s)
						local r = wheelButton.AbsoluteSize.X / 2
						local phi = degToRad(h * 360)
						local len = s * r
						local x = len * math.cos(phi)
						local y = len * math.sin(phi)

						wheelTarget.Position = UDim2.new(0.5, -x, 0.5, y)
						valueBar.BackgroundColor3 = fromHSV(h, s, 1)
					end

					local function updateFromRGB()
						local r = clampInput(redInput.Text, 0, 255)
						local g = clampInput(greenInput.Text, 0, 255)
						local b = clampInput(blueInput.Text, 0, 255)
						redInput.Text = r
						greenInput.Text = g
						blueInput.Text = b

						hue, saturation, value = Color3.fromRGB(r, g, b):ToHSV()

						UpdateSlideFromValue(value)
						UpdateRingFromHSV(hue, saturation)
						updateInputs()
					end

					local function updateFromHex()
						local hex = hexInput.Text
						local r, g, b = hexToRGB(hex)

						r = clampInput(r, 0, 255)
						g = clampInput(g, 0, 255)
						b = clampInput(b, 0, 255)

						redInput.Text = r
						greenInput.Text = g
						blueInput.Text = b

						hue, saturation, value = Color3.fromRGB(r, g, b):ToHSV()
						UpdateSlideFromValue(value)
						UpdateRingFromHSV(hue, saturation)
						updateInputs()
					end

					-- Charge les valeurs depuis le picker actif
					local function loadActivePicker()
						local color = ColorpickerFunctions.Colors[activePickerIndex]
						local alpha = ColorpickerFunctions.Alphas[activePickerIndex]

						local r = math.floor(color.R * 255 + 0.5)
						local g = math.floor(color.G * 255 + 0.5)
						local b = math.floor(color.B * 255 + 0.5)

						redInput.Text = r
						greenInput.Text = g
						blueInput.Text = b
						alphaInput.Text = alpha or 0
						hexInput.Text = string.format("#%02X%02X%02X", r, g, b)

						-- Affiche/masque le row Alpha selon le picker
						alphaInput.Parent.Visible = activeHasAlpha()

						hue, saturation, value = Color3.fromRGB(r, g, b):ToHSV()
						UpdateSlideFromValue(value)
						UpdateRingFromHSV(hue, saturation)

						-- Met à jour le titre du prompt
						if isMulti then
							local cfg = Settings.Colors[activePickerIndex]
							promptHeader.Text = Settings.Name .. " — " .. (cfg.Name or ("Color " .. activePickerIndex))
						else
							promptHeader.Text = Settings.Name
						end
					end

					-- Connexions wheel/slider
					wheelButton.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							WheelDown = true
							UpdateRing(Mouse.X, Mouse.Y)
						end
					end)

					valueBar.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							SlideDown = true
							UpdateSlide(Mouse.X)
						end
					end)

					valueBar.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							SlideDown = false
						end
					end)

					wheelButton.InputEnded:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							WheelDown = false
						end
					end)

					UserInputService.InputChanged:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
							if SlideDown then
								UpdateSlide(Mouse.X)
							elseif WheelDown then
								UpdateRing(Mouse.X, Mouse.Y)
							end
						end
					end)

					hexInput.FocusLost:Connect(updateFromHex)
					redInput.FocusLost:Connect(updateFromRGB)
					greenInput.FocusLost:Connect(updateFromRGB)
					blueInput.FocusLost:Connect(updateFromRGB)
					alphaInput.FocusLost:Connect(function()
						alphaInput.Text = clampInput(alphaInput.Text, 0, 1)
					end)

					-- ============== TRANSITIONS PROMPT ==============
					local function makeCanvas()
						local canvas = Instance.new("CanvasGroup")
						canvas.Name = "ColorPickerCanvas"
						canvas.BackgroundTransparency = 1
						canvas.BorderSizePixel = 0
						canvas.Size = UDim2.fromScale(1, 1)
						canvas.ZIndex = 5
						canvas.GroupTransparency = 1
						canvas.Parent = base
						canvas.Visible = false
						return canvas
					end

					local function transition(isIn)
						local canvas = makeCanvas()
						local tweenTransparency = isIn and 0 or 1
						local tweenScale = isIn and 1 or 0.95
						local stateTransparency = isIn and 1 or 0
						local tweenInfoLocal = TweenInfo.new(0.1, Enum.EasingStyle.Sine)
						local canvasTween = Tween(canvas, tweenInfoLocal, { GroupTransparency = tweenTransparency })
						local scaleTween = Tween(promptUIScale, tweenInfoLocal, { Scale = tweenScale })

						colorPicker.Visible = true
						colorPicker.Parent = canvas
						canvas.Visible = true
						canvas.GroupTransparency = stateTransparency
						canvasTween:Play()
						scaleTween:Play()
						canvasTween.Completed:Wait()

						if not isIn then
							colorPicker.Visible = false
							canvas.Visible = false
						end

						colorPicker.Parent = base
						canvas:Destroy()
					end

					local function colorpickerIn()
						loadActivePicker()
						transition(true)
					end

					local function colorpickerOut()
						transition(false)
					end

					cancel.MouseButton1Click:Connect(colorpickerOut)

					confirm.MouseButton1Click:Connect(function()
						colorpickerOut()
						local c = fromHSV(hue, saturation, value)
						local newColor = Color3.fromRGB(
							math.floor(c.r * 255 + 0.5),
							math.floor(c.g * 255 + 0.5),
							math.floor(c.b * 255 + 0.5)
						)
						local newAlpha = activeHasAlpha() and clampInput(alphaInput.Text, 0, 1) or 0

						ColorpickerFunctions.Colors[activePickerIndex] = newColor
						ColorpickerFunctions.Alphas[activePickerIndex] = newAlpha

						-- Maj rétro-compat
						ColorpickerFunctions.Color = ColorpickerFunctions.Colors[1]
						ColorpickerFunctions.Alpha = ColorpickerFunctions.Alphas[1]

						-- Maj de la pastille visuelle
						local data = pickerData[activePickerIndex]
						if data then
							data.colorFrame.BackgroundColor3 = newColor
							data.colorFrame.BackgroundTransparency = activeHasAlpha() and newAlpha or 0
						end

						-- Callback
						if isMulti then
							local cfg = Settings.Colors[activePickerIndex]
							if cfg and cfg.Callback then
								task.spawn(function()
									cfg.Callback(newColor, cfg.Alpha and newAlpha or nil)
								end)
							end
							-- Callback global (reçoit toutes les couleurs)
							if Settings.Callback then
								task.spawn(function()
									Settings.Callback(ColorpickerFunctions.Colors, ColorpickerFunctions.Alphas, activePickerIndex)
								end)
							end
						else
							if Settings.Callback then
								task.spawn(function()
									Settings.Callback(newColor, Settings.Alpha and newAlpha or nil)
								end)
							end
						end
					end)

