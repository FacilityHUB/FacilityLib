					function ColorpickerFunctions:SetColor(color3, index)
						index = index or 1
						if not pickerData[index] then return end

						ColorpickerFunctions.Colors[index] = color3
						ColorpickerFunctions.Color = ColorpickerFunctions.Colors[1]

						local data = pickerData[index]
						data.colorFrame.BackgroundColor3 = color3

						-- Si le picker est ouvert et c'est l'actif, refresh
						if colorPicker.Visible and activePickerIndex == index then
							loadActivePicker()
						end

						-- Callbacks
						if isMulti then
							local cfg = Settings.Colors[index]
							if cfg and cfg.Callback then
								task.spawn(function()
									cfg.Callback(color3, cfg.Alpha and ColorpickerFunctions.Alphas[index] or nil)
								end)
							end
						else
							if Settings.Callback then
								task.spawn(function()
									Settings.Callback(color3, Settings.Alpha and ColorpickerFunctions.Alphas[1] or nil)
								end)
							end
						end
					end

					function ColorpickerFunctions:SetAlpha(alpha, index)
						index = index or 1
						if not pickerData[index] then return end

						ColorpickerFunctions.Alphas[index] = alpha
						ColorpickerFunctions.Alpha = ColorpickerFunctions.Alphas[1]

						local data = pickerData[index]
						data.colorFrame.BackgroundTransparency = alpha
					end

					function ColorpickerFunctions:GetColor(index)
						return ColorpickerFunctions.Colors[index or 1]
					end

					function ColorpickerFunctions:GetAlpha(index)
						return ColorpickerFunctions.Alphas[index or 1]
					end

